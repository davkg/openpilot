* text=auto

# to move existing files into LFS:
# git add --renormalize .
*.onnx filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

openpilot/selfdrive/car/tests/test_models_segs.txt filter=lfs diff=lfs merge=lfs -text
openpilot/common/hardware/comma/updater filter=lfs diff=lfs merge=lfs -text

# Cruise-step click sounds: kept as plain git blobs, not LFS, as we don't have LFS access
openpilot/selfdrive/assets/sounds/cruise_step_down.wav -filter -diff -merge -text
openpilot/selfdrive/assets/sounds/cruise_step_up.wav -filter -diff -merge -text

# JetBrains Mono fonts: kept as plain git blobs, not LFS, as we don't have LFS access
# JetBrainsMono-Medium.ttf is from upstream
openpilot/selfdrive/assets/fonts/JetBrainsMono-Bold.ttf -filter -diff -merge -text
openpilot/selfdrive/assets/fonts/JetBrainsMono-Regular.ttf -filter -diff -merge -text
openpilot/selfdrive/assets/fonts/JetBrainsMono-SemiBold.ttf -filter -diff -merge -text
